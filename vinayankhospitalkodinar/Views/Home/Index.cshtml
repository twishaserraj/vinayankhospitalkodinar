                    <div class="hero-stats">
                        <div>
                            <div class="hero-stat-number"><span class="counter" data-end="5000" data-suffix="+" data-duration="2000">5000+</span></div>
                            <div class="hero-stat-label">Happy Patients</div>
                        </div>
                        <div>
