    <!-- ===== HERO SECTION ===== -->
    <section class="hero-section" id="hero">
        <!-- Floating decorative orbs -->
        <div class="hero-canvas">
            <div class="hero-orb" style="width:600px;height:600px;background:radial-gradient(circle,rgba(14,165,233,0.12) 0%,transparent 70%);left:30%;top:10%;animation:float 7s ease-in-out infinite"></div>
            <div class="hero-orb" style="width:400px;height:400px;background:radial-gradient(circle,rgba(220,252,231,0.6) 0%,transparent 70%);right:5%;bottom:15%"></div>
            <!-- Floating particles -->
            @for (int i = 0; i < 12; i++)
            {
                var size = (i % 3 + 1) * 4;
                var left = (i * 8 + 5) % 90;
                var top = (i * 7 + 10) % 80;
                var delay = i * 0.3;
                <div style="position:absolute;width:@(size)px;height:@(size)px;border-radius:50%;background:rgba(14,165,233,0.2);left:@(left)%;top:@(top)%;animation:particle-float @(3 + i % 3)s ease-in-out infinite;animation-delay:@(delay)s"></div>
            }
        </div>

        <!-- Trust badges (desktop) -->
        <div class="trust-badges-floating" style="position:absolute;inset:0;pointer-events:none">
            <div class="trust-badge-item" style="right:28%;top:15%;animation-delay:1.2s">
                <div class="trust-badge-icon" style="background:#DCFCE7">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <span class="trust-badge-text">ISO Certified</span>
            </div>
            <div class="trust-badge-item" style="right:2%;top:74%;animation-delay:1.5s">
                <div class="trust-badge-icon" style="background:#FEF3C7">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#D97706" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
                <span class="trust-badge-text">24/7 Emergency</span>
            </div>
             @* <div class="trust-badge-item" style="left:5%;top:70%;animation-delay:1.8s">
                <div class="trust-badge-icon" style="background:#FCE7F3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#DB2777" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>
