<section class="services-section premium-services" id="services">

    <div class="container services-wrapper">

        <div class="section-header">
            <div class="section-badge reveal">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#0EA5E9" stroke-width="2.5">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                <span>Our Medical Services</span>
            </div>

            <h2 class="section-title reveal">
                World-Class <span class="gradient-text">Care for Mothers &amp; Children</span>
            </h2>

            <p class="section-subtitle reveal">
                Premium healthcare services with compassion, expertise, and cutting-edge medical support.
            </p>
        </div>

        <div class="services-bento">
            @{
                var services = new[]
                {
                    new {
                        Number = "01",
                        Title = "Child Vaccination",
                        Desc = "Complete immunization schedules for all age groups to protect against preventable diseases.",
                        Accent = "#0EA5E9",
                        Icon = "/images/vaccination.png",
                        BgImage = "https://images.pexels.com/photos/7653329/pexels-photo-7653329.jpeg"   // transparent PNG
                    },
                    new {
                        Number = "02",
                        Title = "Newborn Care",
                        Desc = "Specialized care for newborns including health assessments, feeding support and early development.",
                        Accent = "#10B981",
                        Icon = "/images/mother-and-baby.gif",
                        BgImage = "https://images.pexels.com/photos/7282608/pexels-photo-7282608.jpeg"       // transparent PNG
                    },
                    new {
                        Number = "03",
                        Title = "Women's Health Checkups",
                        Desc = "Routine and preventive health screenings tailored for women at every stage of life.",
                        Accent = "#8B5CF6",
                        Icon = "/images/requirements.gif",
                        BgImage = "https://images.pexels.com/photos/5215008/pexels-photo-5215008.jpeg"      // transparent PNG
                    },
                    new {
                        Number = "04",
                        Title = "Prenatal Care",
                        Desc = "Early pregnancy monitoring, nutrition guidance and preparation for childbirth.",
                        Accent = "#F97316",
                        Icon = "/images/pregnant-woman.gif",
                        BgImage = "https://images.pexels.com/photos/7108420/pexels-photo-7108420.jpeg"      // transparent PNG
                    }
                };
            }

            @foreach (var svc in services)
            {
                <div class="service-card reveal" style="--accent: @svc.Accent; background-image: url('@svc.BgImage'); background-size: cover; background-position: center; background-repeat: no-repeat;">

                    <!-- FULL IMAGE / ICON LAYER (visible by default) -->
                    <div class="card-image-layer">
                        <div class="icon-bg">
                            <img src="@svc.Icon" alt="@svc.Title">
                        </div>
                        <span class="service-number">@svc.Number</span>
                    </div>

                    <!-- CONTENT LAYER (slides in from RIGHT on hover) -->
                    <div class="card-content-layer">
                        <div class="content-inner">
                            <h3>@svc.Title</h3>
                            <p>@svc.Desc</p>
                            <a href="#" class="service-btn">
                                <span>Learn More</span>
                                <span class="arrow">→</span>
                            </a>
                        </div>
                    </div>

                </div>
            }
        </div>
    </div>
</section>

<script>

    document.addEventListener('DOMContentLoaded', () => {
        const reveals = document.querySelectorAll('.premium-services .reveal');

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                }
            });
        }, {
            threshold: 0.15,
            rootMargin: '0px 0px -40px 0px'
        });

        reveals.forEach(el => observer.observe(el));
    });
</script>