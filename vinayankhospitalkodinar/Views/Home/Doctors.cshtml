<section class="doctors-section" id="doctors">
    <div style="position:absolute;inset:0;pointer-events:none;overflow:hidden">
        <div style="position:absolute;top:80px;left:40px;width:288px;height:288px;border-radius:50%;background:radial-gradient(circle,rgba(14,165,233,0.08) 0%,transparent 70%)" class="animate-float-reverse"></div>
        <div style="position:absolute;bottom:80px;right:40px;width:256px;height:256px;border-radius:50%;background:radial-gradient(circle,rgba(236,72,153,0.08) 0%,transparent 70%)" class="animate-float"></div>
    </div>
    <div class="container" style="position:relative;z-index:1">
        <div class="section-header">
            <div class="section-badge">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0EA5E9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                <span>Our Specialist Doctors</span>
            </div>
            <h2 class="section-title reveal">Expert Doctors You Can <span class="gradient-text">Trust</span></h2>
            <p class="section-subtitle reveal">Our highly qualified specialists bring years of experience and genuine compassion to every patient encounter.</p>
        </div>

        <div class="doctors-grid">

            <!-- Pediatrician Card -->
            <div class="doctor-card reveal-left">
                <!-- Full card image (replace src with your real photo) -->
                <img src="~/images/viyananksir.jpeg"
                     alt="Dr Pradhyuman Jadav"
                     class="doctor-card-img">

                <!-- Soft gradient overlay (always present for depth) -->
                <div class="doctor-card-overlay" style="background:linear-gradient(to top, rgba(14,165,233,0.85) 0%, rgba(14,165,233,0.35) 40%, transparent 70%)"></div>

                <!-- Content that slides up from bottom -->
                <div class="doctor-card-content">
                    <div class="doctor-specialty" style="color:#0EA5E9">PEDIATRICIAN</div>
                    <div class="doctor-title">
                        Dr Pradhyuman Jadav
                        <br><span class="specialist">(Child Specialist)</span>
                    </div>
                    <div class="doctor-stars">
                        @for (int i = 0; i < 5; i++)
                        {
                            <div class="doctor-star" style="background:linear-gradient(135deg,#0EA5E9,#0284C7)"></div>
                        }
                        <span style="color:#64748B;font-size:12px;margin-left:4px">10+ Years</span>
                    </div>
                    <p class="doctor-desc">
                        Dedicated to the health and development of children from newborns through adolescence, providing comprehensive pediatric care with the latest medical expertise.
                    </p>
                    <a asp-action="Contact" class="doctor-cta" style="background:linear-gradient(135deg,#0EA5E9,#0284C7);box-shadow:0 10px 30px rgba(14,165,233,0.35)">
                        View More Info <span>→</span>
                    </a>
                </div>
            </div>

            <!-- Gynecologist Card -->
            <div class="doctor-card reveal-right">
                <!-- Full card image (replace src with your real photo) -->
                <img src="~/images/vinayankmrs.jpeg"
                     alt="Dr Hetal Jadav"
                     class="doctor-card-img" loading="lazy"
                     decoding="async">

                <!-- Soft gradient overlay -->
                <div class="doctor-card-overlay" style="background:linear-gradient(to top, rgba(236,72,153,0.85) 0%, rgba(236,72,153,0.35) 40%, transparent 70%)"></div>

                <!-- Content that slides up from bottom -->
                <div class="doctor-card-content">
                    <div class="doctor-specialty" style="color:#EC4899">GYNECOLOGIST</div>
                    <div class="doctor-title">
                        Dr Hetal Jadav
                        <br><span class="specialist">(Women's Health Specialist)</span>
                    </div>
                    <div class="doctor-stars">
                        @for (int i = 0; i < 5; i++)
                        {
                            <div class="doctor-star" style="background:linear-gradient(135deg,#EC4899,#BE185D)"></div>
                        }
                        <span style="color:#64748B;font-size:12px;margin-left:4px">12+ Years</span>
                    </div>
                    <p class="doctor-desc">
                        Comprehensive women's healthcare from adolescence through menopause, offering expert gynecological care and obstetric services with compassion and expertise.
                    </p>
                    <a asp-action="Contact" class="doctor-cta" style="background:linear-gradient(135deg,#EC4899,#BE185D);box-shadow:0 10px 30px rgba(236,72,153,0.35)">
                        View More Info <span>→</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>
