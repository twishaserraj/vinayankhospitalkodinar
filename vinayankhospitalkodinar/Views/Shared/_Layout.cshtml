<body>

    <!-- NAVBAR -->
    <nav class="site-nav">
        <div class="nav-inner">

            <a asp-controller="Home" asp-action="Index" class="nav-logo">
                <div class="nav-logo-icon">
                    <img src="~/images/logo.png"
                         alt="Vinayak Hospital Logo"
                         style="width:50px;height:50px;object-fit:contain;" />
                </div>

                <div class="nav-logo-text">
                    <div class="nav-logo-name">Vinayak Children & Maternity</div>
                    <div class="nav-logo-sub">Hospital</div>
                </div>
            </a>

            <div class="nav-links">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="About">About</a>
                <a asp-controller="Home" asp-action="Doctors">Doctors</a>
                <a asp-controller="Home" asp-action="Services">Services</a>
                <a asp-controller="Home" asp-action="Gallery">Gallery</a>
                <a asp-controller="Home" asp-action="Contact">Contact</a>
            </div>

            <div class="nav-cta">
                <a asp-controller="Home" asp-action="Contact" class="btn-primary">Book Appointment</a>
            </div>

            <button class="nav-mobile-toggle">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="nav-mobile-menu">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="Home" asp-action="About">About</a>
            <a asp-controller="Home" asp-action="Doctors">Doctors</a>
            <a asp-controller="Home" asp-action="Services">Services</a>
            <a asp-controller="Home" asp-action="Gallery">Gallery</a>
            <a asp-controller="Home" asp-action="Contact">Contact</a>
            <a asp-controller="Home" asp-action="Contact" class="btn-primary" style="text-align:center;justify-content:center">Book Appointment</a>
        </div>
    </nav>

    <!-- PAGE CONTENT -->
    @RenderBody()

