<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Providing trusted pediatric and gynecological healthcare with compassion, expertise, and modern medical care. Book your appointment today." />
    <meta name="keywords" content="Vinayak Hospital, pediatrician, gynecologist, child specialist, women's health, pregnancy care, newborn care" />

    <title>Vinayak Children & Maternity Hospital</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
